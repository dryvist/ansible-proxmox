---
# Proxmox VE Server Inventory
# Copy this file to hosts.yml and customize for your environment.
# Sample IPs use the 192.168.0.x placeholder prefix.
#
# `rack_servers` is nested under `proxmox.children` so:
#   1. `load_tofu.yml` (imported by site.yml) injects
#      `nas_storage_from_tofu` for `groups['proxmox']` — children inherit.
#   2. After commissioning, `playbooks/site.yml` (which targets `hosts: proxmox`)
#      manages rack servers alongside the original node-a host.
#
# Rack-server commissioning runs AFTER `pvecm add` joins the node to the cluster;
# see `playbooks/commission_rack_server.yml`.
#
# `pve_cluster_members` lists the nodes the `pve_cluster` role may form/join.
# Keep uncommissioned nodes (e.g. one with a failed drive) OUT of this group
# until they are ready — the role hard-refuses to touch a non-member host.

all:
  children:
    proxmox:
      hosts:
        node-a:
          ansible_host: 192.168.0.100  # Replace with your Proxmox IP
          ansible_user: root
          proxmox_node_name: node-a
          # ansible_ssh_private_key_file: /path/to/your/ssh/key  # Uncomment and set your SSH key path
        node-b:
          ansible_host: 192.168.0.11
          ansible_user: root
          proxmox_node_name: node-b
        node-c:
          ansible_host: 192.168.0.12
          ansible_user: root
          proxmox_node_name: node-c
          pve_node_commissioned: false  # set true once hardware is ready
      children:
        # Cluster-eligible nodes. node-c omitted while uncommissioned.
        pve_cluster_members:
          hosts:
            node-a: {}
            node-b: {}
        rack_servers:
          hosts:
            node-a:
              ansible_host: 192.168.0.11
              ansible_user: root
              rack_server_bmc_ip: 192.168.0.10
              rack_server_chassis: r410
            node-b:
              ansible_host: 192.168.0.21
              ansible_user: root
              rack_server_bmc_ip: 192.168.0.20
              rack_server_chassis: r710
