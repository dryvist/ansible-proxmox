---
# Example host_vars for a rack server — copy to
# `inventory/host_vars/<node-name>.yml` (untracked by default) and fill in
# real values. SOPS-encrypt the resulting file if it carries sensitive paths.
#
# Note: the existing `load_terraform.yml` only injects NAS `host_services`
# and does NOT populate rack-server per-host vars. Wiring `terraform-proxmox`'s
# `rack_servers` output into Ansible host_vars is a forward-looking
# enhancement — for now, populate this file manually.
#
# Sample values use the 192.168.0.x placeholder prefix per the public-repo policy.

# Connection
ansible_host: 192.168.0.11        # PVE host management IP
ansible_user: root
# ansible_ssh_private_key_file: ~/.ssh/id_rsa_pve

# BMC sidecar (optional — used by future racadm/ipmitool tasks; iDRAC on Dell,
# iLO on HPE, IMM on Lenovo, etc.)
rack_server_bmc_ip: 192.168.0.10
rack_server_chassis: r410         # free-form model name (r410, r710, dl360-g6, ...)
rack_server_service_tag: EXAMPLE1

# Expected hardware (for sanity-check tasks; not enforced by default)
rack_server_expected_ram_gb: 32
rack_server_expected_cpu_sockets: 2

# Cluster role flags
rack_server_enable_nas_storage: false  # set true on the node that hosts the NAS ZFS dataset

# Storage pools to import / verify (real device paths in SOPS-encrypted overrides)
rack_server_storage_pools:
  - name: local-zfs
    device: /dev/disk/by-id/CHANGE-ME

# PVE cluster context (must match existing cluster name)
pve_cluster_name: example-cluster
