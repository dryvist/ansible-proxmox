{{ ansible_managed | comment }}
# Re-apply magic-packet Wake-on-LAN on every interface add -- the driver
# resets Wake-on to its hardware default (usually disabled) on every
# bring-up, so `ethtool -s wol g` alone does not survive a reboot.
{% if wol_enable_mac | trim | length > 0 %}
ACTION=="add", SUBSYSTEM=="net", ATTR{address}=="{{ wol_enable_mac | lower }}", RUN+="/usr/sbin/ethtool -s $env{INTERFACE} wol g"
{% else %}
ACTION=="add", SUBSYSTEM=="net", KERNEL=="{{ wol_enable_interface }}", RUN+="/usr/sbin/ethtool -s $env{INTERFACE} wol g"
{% endif %}
