#!/bin/bash
# syncoid replication — pull ZFS datasets to this (target) node.
# Managed by Ansible — do not edit manually. One run per configured job; a
# failed job (e.g. source offline) is logged and does NOT abort the rest — but
# IS counted. Any failed job makes the script exit non-zero and ping the
# healthchecks.io /fail endpoint (if configured); a per-dataset failure must
# never exit 0 silently, or nobody is ever alerted to an incomplete backup.
#
# Usage: syncoid-replicate.sh [schedule-group]
# Runs only the jobs belonging to that group (default: "default"), so datasets
# with different RPOs can be driven by separate cron lines from one wrapper.
set -uo pipefail

group="${1:-default}"

# syncoid/sanoid install to /usr/sbin on Debian, which is NOT on cron's default
# PATH (/usr/bin:/bin). Without this, the scheduled run dies with
# "syncoid: command not found" (rc=127) on every job — and because replicate()
# logs the failure but keeps going, the script still exits 0, so the breakage is
# silent. Pin a complete PATH so cron resolves the binary the same way an
# interactive shell does.
export PATH="/usr/sbin:/sbin:/usr/bin:/bin${PATH:+:$PATH}"

LOG_DIR="{{ syncoid_log_dir }}"
# Per-group healthcheck. One shared URL across every group means a failing
# group is masked by a passing one — the check goes green on whichever group
# pings last. A group with no entry falls back to the shared URL, so a node
# that has not split its checks yet behaves exactly as before.
case "$group" in
{% for g, url in (syncoid_healthcheck_urls | default({})).items() %}
  {{ g }}) HC="{{ url }}" ;;
{% endfor %}
  *) HC="{{ syncoid_healthcheck_url }}" ;;
esac
mkdir -p "$LOG_DIR"
log="$LOG_DIR/$(date +%Y-%m-%d).log"

# Two groups can be mid-run at once (an hourly line overlapping a long default
# run), and a partial second copy of a dataset is worse than a skipped cycle.
# Serialize per group: the same group never overlaps itself, different groups
# still run concurrently.
# One syslog line per job and per run, so the result reaches the log pipeline
# rather than only the local log file. The first argument is the syslog
# priority. A logger failure never changes the run's result, and each call is
# capped at five seconds so a stalled syslog socket cannot delay the healthcheck.
slog() { local prio="$1"; shift; timeout 5 logger -t syncoid-replicate -p "$prio" -- "$*" >/dev/null 2>&1 || true; }

exec 9>"$LOG_DIR/.${group}.lock"
if ! flock -n 9; then
  echo "=== $(date +%H:%M:%S) skipped: $group already running ===" >>"$log"
  slog daemon.warning "run group=$group result=skipped reason=lock_held"
  exit 0
fi

ping_hc() { [ -n "$HC" ] && curl -fsS -m 10 --retry 3 -o /dev/null "$1" >/dev/null 2>&1 || true; }

replicate() {
  local name="$1"; shift
  echo "=== $(date +%H:%M:%S) syncoid $* ===" >>"$log"
  local rc=0 start=$SECONDS
  syncoid "$@" >>"$log" 2>&1 || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "  FAILED (rc=$rc)" >>"$log"
    failed="$failed $name"
    slog daemon.err "job=$name group=$group result=failed rc=$rc duration_s=$((SECONDS - start))"
  else
    slog daemon.info "job=$name group=$group result=ok rc=0 duration_s=$((SECONDS - start))"
  fi
}

failed=""
ran=0
{% for job in syncoid_jobs %}
if [ "$group" = "{{ job.schedule | default('default') }}" ]; then
  ran=$((ran + 1))
  replicate "{{ job.name }}" {{ job.options | default(syncoid_default_options) }} {{ job.source }} {{ job.target }}
fi
{% endfor %}

# A group that matched nothing means a cron line is firing for a group whose
# jobs were removed — report it rather than pinging success for doing nothing.
if [ "$ran" -eq 0 ]; then
  echo "=== $(date +%H:%M:%S) no jobs in group '$group' ===" >>"$log"
  slog daemon.err "run group=$group result=no_jobs jobs=0"
  exit 1
fi

# Ping before logging, so a blocked syslog socket cannot delay the healthcheck.
if [ -n "$failed" ]; then
  echo "=== $(date +%H:%M:%S) FAILED jobs:$failed ===" >>"$log"
  ping_hc "${HC}/fail"
  slog daemon.err "run group=$group result=failed jobs=$ran failed_jobs=${failed# }"
  exit 1
fi
ping_hc "${HC}"
slog daemon.info "run group=$group result=ok jobs=$ran"
