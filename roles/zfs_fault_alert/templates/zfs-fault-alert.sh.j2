#!/bin/bash
{{ ansible_managed | comment }}
#
# Shared alert body for zed.d/checksum-notify.sh, zed.d/delay-notify.sh, and
# the missed-events poller. Publishes to the homelab ntfy alert hub -- not a
# log line -- because the drive this exists for (Zammad #17242) showed a
# real, signature-matched corruption-plus-hang event 3 times in 8 days while
# SMART read PASSED throughout. A stuck monitor or a log nobody reads is not
# a control.
#
# Fires a fresh publish per occurrence rather than suppressing repeats: the
# hub fans out to Slack and Zammad, and a recurrence must not go silent just
# because an earlier occurrence was already acknowledged.
set -uo pipefail

TOKEN_FILE=/etc/zfs-fault-alert/ntfy-token
URL="{{ zfs_fault_alert_ntfy_url }}"

REASON="${1:?usage: zfs-fault-alert.sh <reason> <detail...>}"
shift
DETAIL="$*"

AUTH=()
if [[ -r "$TOKEN_FILE" ]]; then
  AUTH=(-H "Authorization: Bearer $(<"$TOKEN_FILE")")
fi

# --self-check validates wiring (hub reachable) without publishing an alert
# -- a self-check that published would page Slack/Zammad on every converge.
# Used by the Ansible converge as end-to-end proof this is actually live,
# not just "files present."
if [[ "$REASON" == "--self-check" ]]; then
  base_url="${URL%/*}"
  code=$(curl -fsS -o /dev/null -w '%{http_code}' --max-time 10 \
    "${AUTH[@]}" "${base_url}/v1/health")
  if [[ "$code" == "200" ]]; then
    echo "zfs-fault-alert self-check OK (ntfy hub reachable)"
    exit 0
  fi
  echo "zfs-fault-alert self-check FAILED: ntfy hub returned HTTP $code" >&2
  exit 1
fi

logger -t zfs-fault-alert "FIRING: $REASON $DETAIL"

title="$(hostname -f) ${REASON} -- ZFS fault signature, IMMEDIATE REPLACEMENT TRIGGER"
body="Auto-filed by zed on $(hostname -f) at $(date -u +%FT%TZ).

Reason: ${REASON}
Detail: ${DETAIL}

This fires on any zed checksum/delay event on this host's watched vdev, or on
zed reporting a missed-events queue overflow. See Zammad #17242 for the
originating investigation and the drive-replacement decision this signature
already triggered once. If that ticket is closed, this is a NEW occurrence on
a device that should already have been swapped -- treat as immediate."

if ! curl -fsS --max-time 15 -o /dev/null -X POST \
    -H "Title: ${title}" -H "Priority: high" -H "Tags: zfs" \
    "${AUTH[@]}" --data-binary "$body" \
    "$URL"; then
  logger -t zfs-fault-alert "FAILED to reach the ntfy hub for: $REASON $DETAIL"
  exit 1
fi
logger -t zfs-fault-alert "published: $REASON $DETAIL"
