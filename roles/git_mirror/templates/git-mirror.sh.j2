#!/bin/bash
# git-mirror — daily bare-mirror of every configured owner's PUBLIC
# repositories. Managed by Ansible — do not edit manually.
#
# v1 scope: public repos only, cloned/fetched anonymously over HTTPS. Each
# owner's repo list is enumerated at runtime from the GitHub API — never
# baked into this script — so a new repo is picked up on the next run with
# no converge needed. A failed clone/update is logged and does NOT abort the
# rest of the run.
set -uo pipefail

DEST="{{ git_mirror_archive_dir }}"
LOG_DIR="{{ git_mirror_log_dir }}"
HC="{{ git_mirror_healthcheck_url }}"
mkdir -p "$DEST" "$LOG_DIR"
log="$LOG_DIR/$(date +%Y-%m-%d).log"

say()     { echo "=== $(date +%H:%M:%S) $* ===" >>"$log"; }
ping_hc() { [ -n "$HC" ] && curl -fsS -m 10 --retry 3 -o /dev/null "$1" >/dev/null 2>&1 || true; }

rc=0
{% for owner in git_mirror_owners %}
say "enumerating public repos for {{ owner }}"
repos=$(curl -fsS -m 30 "https://api.github.com/users/{{ owner }}/repos?type=public&per_page=100" \
  | python3 -c 'import json,sys; print("\n".join(r["name"] for r in json.load(sys.stdin)))' 2>>"$log") \
  || { say "  FAILED: enumerate {{ owner }}"; rc=1; repos=""; }
while IFS= read -r name; do
  [ -n "$name" ] || continue
  path="$DEST/{{ owner }}/${name}.git"
  if [ -d "$path" ]; then
    if ! git -C "$path" remote update --prune >>"$log" 2>&1; then
      say "  FAILED: update {{ owner }}/${name}"
      rc=1
    fi
  else
    mkdir -p "$(dirname "$path")"
    if ! git clone --mirror "https://github.com/{{ owner }}/${name}.git" "$path" >>"$log" 2>&1; then
      say "  FAILED: clone {{ owner }}/${name}"
      rm -rf "$path"
      rc=1
    fi
  fi
done <<<"$repos"
{% endfor %}

if [ "$rc" -ne 0 ]; then
  say "one or more mirrors FAILED"
  ping_hc "${HC}/fail"
  exit 1
fi
say "all mirrors OK"
ping_hc "${HC}"
