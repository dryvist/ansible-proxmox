{{ ansible_managed | comment }}
[Unit]
Description=Daily bare-mirror of every configured owner's public repositories
Documentation=https://github.com/dryvist/ansible-proxmox/tree/main/roles/git_mirror

[Timer]
OnCalendar={{ git_mirror_on_calendar }}
Persistent={{ git_mirror_persistent | ternary('true', 'false') }}

[Install]
WantedBy=timers.target
