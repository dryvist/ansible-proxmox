{{ ansible_managed | comment }}
#
# ZFS kernel module parameters. Managed by ansible-proxmox roles/zfs_pools.
# Sourced from the per-node tofu declaration (node_storage.<node>.module_params)
# via zfs_pools_module_params.
#
# These are applied at module load. Values under /sys/module/zfs/parameters/ can
# be changed at runtime, but a runtime `echo` REVERTS ON REBOOT -- which is why
# they belong here. Anything tuned live must land in the tofu declaration or it
# silently disappears at the next boot.
{% for key, value in zfs_pools_module_params | dictsort %}
{% if zfs_pools_module_param_comments.get(key) %}
# {{ zfs_pools_module_param_comments[key] }}
{% endif %}
options zfs {{ key }}={{ value }}
{% endfor %}
