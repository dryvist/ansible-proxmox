# Managed by Ansible — do not edit manually.
# ZFS snapshot retention (sanoid). https://github.com/jimsalterjrs/sanoid
{% set rendered_templates = sanoid_templates | combine(
  sanoid_replica_templates if sanoid_replica_retention_enabled else {}
) %}{% for tname, opts in rendered_templates | dictsort %}

[template_{{ tname }}]
{% for k, v in opts | dictsort %}
        {{ k }} = {{ v }}
{% endfor %}
{% endfor %}
{% set rendered_datasets = sanoid_datasets | combine(
  sanoid_replica_datasets if sanoid_replica_retention_enabled else {}
) %}{% for ds, opts in rendered_datasets | dictsort %}

[{{ ds }}]
{% for k, v in opts | dictsort %}
        {{ k }} = {{ v }}
{% endfor %}
{% endfor %}
