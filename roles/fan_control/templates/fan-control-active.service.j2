[Unit]
Description=Activate selected fan mode
After=coolercontrold.service
Requires=coolercontrold.service

[Service]
Type=oneshot
ExecStart=/usr/bin/curl --fail --silent --show-error --request POST --header @/etc/coolercontrol/fan-control.headers {{ fan_control_api_url }}/modes-active/{{ fan_control_active_mode_uid }}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
