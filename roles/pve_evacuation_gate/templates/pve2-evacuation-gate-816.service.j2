# {{ ansible_managed }}
[Unit]
Description=Verify pve2 evacuation source integrity for issue 816
Documentation=https://github.com/dryvist/ansible-proxmox/tree/develop/roles/pve_evacuation_gate
After=zfs-import.target zfs-mount.service pve-cluster.service
Wants=zfs-import.target
Requires=zfs-mount.service pve-cluster.service

[Service]
Type=oneshot
ExecStart={{ pve_evacuation_gate_script_path }}

# Each run is bounded: extended SMART tests run inside their disks, while the
# timer polls their logs.  A failed integrity assertion must remain failed for
# investigation instead of restarting in a loop and obscuring its first error.
TimeoutStartSec=10min
Restart=no

StateDirectory={{ pve_evacuation_gate_unit_name }}
StateDirectoryMode=0700
UMask=0077
Nice=19
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
NoNewPrivileges=yes
