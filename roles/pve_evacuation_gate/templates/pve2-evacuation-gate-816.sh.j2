#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Stateful, reboot-persistent source-integrity gate for the pve2 -> pve540
# evacuation.  It observes only; it never clears ZFS errors, changes snapshot
# policy, alters replication, or moves data.  The only hardware action is the
# explicitly requested extended SMART test after the observed scrub completes.

set -Eeuo pipefail

readonly pool="{{ pve_evacuation_gate_pool }}"
readonly phase="{{ pve_evacuation_gate_phase }}"
readonly state_dir="{{ pve_evacuation_gate_state_dir }}"
readonly tag="{{ pve_evacuation_gate_unit_name }}"
readonly lock_path="/run/${tag}.lock"

mkdir -p "$state_dir"
chmod 0700 "$state_dir"
exec 9>"$lock_path"
flock -n 9 || exit 0

log() {
  local priority="$1"
  shift
  logger -t "$tag" -p "$priority" -- "$*" || true
}

restore_smartd() {
  local smartd_state="$state_dir/smartd-gate-state"
  [ -e "$smartd_state" ] || return 0
  if [ "$(cat "$smartd_state")" = active ]; then
    systemctl start smartd || return 1
  fi
  rm -f "$smartd_state"
}

suspend_smartd() {
  local smartd_state="$state_dir/smartd-gate-state"
  if [ ! -e "$smartd_state" ]; then
    if systemctl is-active --quiet smartd; then
      printf '%s\n' active >"$smartd_state"
    else
      printf '%s\n' inactive >"$smartd_state"
    fi
  fi
  systemctl stop smartd || fail "cannot stop smartd before gate-owned extended tests"
}

fail() {
  local message="$*"
  if [ ! -e "$state_dir/FAILED" ]; then
    printf '%s %s\n' "$(date --iso-8601=seconds)" "$message" >"$state_dir/FAILED"
  fi
  restore_smartd || log daemon.err "failed to restore smartd after integrity failure"
  log daemon.err "$message"
  exit 1
}

trap 'rc=$?; if (( rc != 0 )); then restore_smartd || true; fi' EXIT

if [ -e "$state_dir/FAILED" ]; then
  fail "previous integrity failure is recorded in $state_dir/FAILED; remediate and remove that marker deliberately"
fi

boot_id="$(cat /proc/sys/kernel/random/boot_id)"
qualification_boot_id="$state_dir/qualification.boot-id"
if [ -e "$qualification_boot_id" ]; then
  [ "$(cat "$qualification_boot_id")" = "$boot_id" ] \
    || fail "host rebooted during source qualification; restart the integrity sequence from the initial scrub"
else
  printf '%s\n' "$boot_id" >"$qualification_boot_id"
fi

capture() {
  local name="$1"
  shift
  local target="$state_dir/${name}.$(date -u +%Y%m%dT%H%M%SZ)"
  "$@" >"$target" 2>&1 || fail "failed to capture $name"
  printf '%s\n' "$target"
}

capture_smart() {
  local name="$1"
  shift
  local target="$state_dir/${name}.$(date -u +%Y%m%dT%H%M%SZ)" rc
  set +e
  "$@" >"$target" 2>&1
  rc=$?
  set -e
  if (( (rc & 7) != 0 )); then
    fail "failed to read SMART data for $name (smartctl exit $rc)"
  fi
  printf '%s\n' "$target"
}

assert_no_snapshots_or_freeing() {
  local snapshots freeing pool_name
  snapshots="$(zfs list -H -t snapshot -o name)" || fail "cannot list ZFS snapshots"
  [ -z "$snapshots" ] || fail "ZFS snapshots exist during the evacuation: $snapshots"

  local pool_list
  pool_list="$(zpool list -H -o name,freeing)" || fail "cannot list ZFS deferred-freeing state"
  while read -r pool_name freeing; do
    case "$freeing" in
      0|0B|0.00B) ;;
      *) fail "pool $pool_name still has deferred freeing: $freeing" ;;
    esac
  done <<<"$pool_list"
}

assert_snapshot_producers_disabled() {
  systemctl is-enabled --quiet sanoid.timer && fail "sanoid.timer is enabled"
  systemctl is-active --quiet sanoid.timer && fail "sanoid.timer is active"
  [ ! -e /etc/cron.d/syncoid ] || fail "Syncoid cron schedule is still present"
  if crontab -l 2>/dev/null | grep -qi 'syncoid'; then
    fail "root crontab still contains a Syncoid schedule"
  fi
  systemctl is-enabled --quiet syncoid-replicate-on-boot.service && fail "Syncoid boot service is enabled"
  systemctl is-active --quiet syncoid-replicate-on-boot.service && fail "Syncoid boot service is active"

  local replication backup resources
  replication="$(pvesh get /cluster/replication --output-format json)" || fail "cannot read PVE replication configuration"
  backup="$(pvesh get /cluster/backup --output-format json)" || fail "cannot read PVE backup configuration"
  resources="$(pvesh get /cluster/resources --type vm --output-format json)" || fail "cannot read PVE guest placement"
  REPLICATION_JSON="$replication" BACKUP_JSON="$backup" RESOURCES_JSON="$resources" /usr/bin/python3 - <<'PY' || fail "a pve2 replication or snapshot-mode backup producer is enabled"
import json
import os
import sys

replication = json.loads(os.environ["REPLICATION_JSON"])
backup = json.loads(os.environ["BACKUP_JSON"])
resources = json.loads(os.environ["RESOURCES_JSON"])
required_disabled_replication = {{ pve_evacuation_gate_prohibited_replication_ids | to_json }}
replication_by_id = {item.get("id"): item for item in replication}

def disabled(item):
    return str(item.get("disable", 0)).lower() in {"1", "true", "yes"}

enabled_replication = [
    job_id
    for job_id in required_disabled_replication
    if job_id in replication_by_id and not disabled(replication_by_id[job_id])
]

protected_node = {{ pve_evacuation_gate_protected_node | to_json }}
enabled_source_replication = [
    item.get("id", "unknown")
    for item in replication
    if not disabled(item) and item.get("source") == protected_node
]
pve2_vmids = {
    str(item.get("vmid"))
    for item in resources
    if item.get("node") == protected_node and item.get("vmid") is not None
}

def backup_enabled(item):
    return str(item.get("enabled", 1)).lower() in {"1", "true", "yes"}

def backup_applies_to_protected_node(job):
    configured = str(job.get("vmid", "")).strip()
    if not configured:
        return bool(pve2_vmids)
    return bool(pve2_vmids.intersection(part.strip() for part in configured.split(",")))

snapshot_backups = [
    item.get("id", "unknown")
    for item in backup
    if (
        backup_enabled(item)
        and backup_applies_to_protected_node(item)
        and item.get("mode", "snapshot") == "snapshot"
    )
]
if enabled_replication or enabled_source_replication or snapshot_backups:
    print(
        "enabled_replication=%s enabled_source_replication=%s snapshot_backups=%s"
        % (enabled_replication, enabled_source_replication, snapshot_backups),
        file=sys.stderr,
    )
    sys.exit(1)
PY
}

assert_scrub_result() {
  local report="$1"
  grep -q '^  pool: ' "$report" || fail "cannot identify pool in zpool status output"
  grep -q 'state: ONLINE' "$report" || fail "pool $pool is not ONLINE"
  grep -q 'scrub repaired 0B' "$report" || fail "latest scan for $pool is not a clean completed scrub"
  grep -q 'errors: No known data errors' "$report" || fail "pool $pool reports known data errors"
}

assert_zero_vdev_errors() {
  local report="$1"
  awk '
    /^config:/{config=1; next}
    config && /^[[:space:]]*NAME[[:space:]]+STATE/{next}
    config && NF >= 5 && $2 ~ /^(ONLINE|DEGRADED|FAULTED|OFFLINE|UNAVAIL|REMOVED)$/ {
      if (($3 + 0) || ($4 + 0) || ($5 + 0)) exit 1
    }
  ' "$report" || fail "pool $pool has non-zero read, write, or checksum counters"
}

verify_device_serial() {
  local device="$1" type="$2" index="$3" expected_serial="$4" identity actual_serial
  identity="$(capture "smart-${expected_serial}-identity" smartctl -j -i -d "${type},${index}" "$device")"
  actual_serial="$(/usr/bin/python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("serial_number", ""))' "$identity")" \
    || fail "cannot parse SMART identity for $expected_serial"
  [ "$actual_serial" = "$expected_serial" ] || fail "SMART device ${device} ${type},${index} serial $actual_serial does not match expected $expected_serial"
}

start_extended_test() {
  local device="$1" type="$2" index="$3" serial="$4" baseline started_hours baseline_hash boot_id
  verify_device_serial "$device" "$type" "$index" "$serial"
  baseline="$(capture_smart "smart-${serial}-pretest" smartctl -j -a -d "${type},${index}" "$device")"
  started_hours="$(/usr/bin/python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("power_on_time", {}).get("hours", -1))' "$baseline")" \
    || fail "cannot parse SMART power-on hours for $serial"
  [ "$started_hours" -ge 0 ] || fail "cannot read SMART power-on hours for $serial"
  baseline_hash="$(/usr/bin/python3 - "$baseline" <<'PY'
import hashlib
import json
import sys

data = json.load(open(sys.argv[1]))
table = data.get("ata_smart_self_test_log", {}).get("standard", {}).get("table", [])
encoded = json.dumps(table, sort_keys=True, separators=(",", ":")).encode()
print(hashlib.sha256(encoded).hexdigest())
PY
)" || fail "cannot fingerprint the pre-test SMART log for $serial"
  boot_id="$(cat /proc/sys/kernel/random/boot_id)"
  suspend_smartd
  rm -f "$state_dir/smart-${serial}-observed-in-progress"
  smartctl -t long -d "${type},${index}" "$device" >"$state_dir/smart-${serial}-start.$(date -u +%Y%m%dT%H%M%SZ)" 2>&1 \
    || fail "could not start extended SMART test for $serial"
  printf '%s %s %s\n' "$started_hours" "$boot_id" "$baseline_hash" >"$state_dir/smart-${serial}-started"
  log daemon.notice "started extended SMART test for $serial"
}

smart_test_state() {
  local device="$1" type="$2" index="$3" serial="$4" started_file="$5" result
  result="$(capture_smart "smart-${serial}-selftest" smartctl -j -a -d "${type},${index}" "$device")"
  /usr/bin/python3 - "$result" "$started_file" <<'PY'
import json
import hashlib
import sys

data = json.load(open(sys.argv[1]))
started_hours, started_boot, baseline_hash = open(sys.argv[2]).read().split()
started_hours = int(started_hours)
current_boot = open("/proc/sys/kernel/random/boot_id").read().strip()
if current_boot != started_boot:
    print("rebooted")
    raise SystemExit(0)
current_status = (
    data.get("ata_smart_data", {})
    .get("self_test", {})
    .get("status", {})
    .get("string", "")
    .lower()
)
if "in progress" in current_status:
    print("pending")
    raise SystemExit(0)
table = data.get("ata_smart_self_test_log", {}).get("standard", {}).get("table", [])
if not table:
    print("failed")
    raise SystemExit(0)
latest = table[0]
table_hash = hashlib.sha256(
    json.dumps(table, sort_keys=True, separators=(",", ":")).encode()
).hexdigest()
status = latest.get("status", {}).get("string", "").lower()
test_type = latest.get("type", {}).get("string", "").lower()
test_hours = int(latest.get("lifetime_hours", -1))
if (
    "extended" in test_type
    and "completed without error" in status
    and test_hours >= started_hours
    and table_hash != baseline_hash
    and data.get("smart_status", {}).get("passed") is True
):
    print("passed")
elif "aborted" in status or "interrupted" in status:
    print("aborted")
else:
    print("failed")
PY
}

assert_no_snapshots_or_freeing
assert_snapshot_producers_disabled

report="$(capture "zpool-${pool}-status" zpool status -v "$pool")"
marker="$state_dir/${phase}.scrub-observed"

if grep -q 'scrub in progress' "$report"; then
  if [ -e "$marker" ] && [ "$(cat "$marker")" != "$boot_id" ]; then
    fail "host rebooted after the $phase scrub was first observed; refusing to accept a cross-boot scrub result"
  fi
  printf '%s\n' "$boot_id" >"$marker"
  log daemon.notice "scrub is still running for $pool"
  exit 0
fi

[ -e "$marker" ] || fail "the $phase gate never observed a running scrub; refusing to accept an old result"
[ "$(cat "$marker")" = "$boot_id" ] || fail "host rebooted during the $phase scrub; refusing to accept its result"
assert_scrub_result "$report"

all_smart_passed=true
{% for smart_device in pve_evacuation_gate_smart_devices %}
serial='{{ smart_device.serial }}'
if [ ! -e "$state_dir/smart-${serial}-started" ]; then
  start_extended_test '{{ smart_device.device }}' '{{ smart_device.type }}' '{{ smart_device.index }}' "$serial"
  all_smart_passed=false
else
  suspend_smartd
  verify_device_serial '{{ smart_device.device }}' '{{ smart_device.type }}' '{{ smart_device.index }}' "$serial"
  if ! test_state="$(smart_test_state '{{ smart_device.device }}' '{{ smart_device.type }}' '{{ smart_device.index }}' "$serial" "$state_dir/smart-${serial}-started")"; then
    fail "cannot parse extended SMART state for $serial"
  fi
  case "$test_state" in
    passed)
      [ -e "$state_dir/smart-${serial}-observed-in-progress" ] \
        || fail "gate-owned extended SMART test for $serial was never observed in progress"
      ;;
    pending)
      touch "$state_dir/smart-${serial}-observed-in-progress"
      all_smart_passed=false
      log daemon.notice "extended SMART test is still running for $serial"
      ;;
    aborted)
      rm -f "$state_dir/smart-${serial}-started"
      rm -f "$state_dir/smart-${serial}-observed-in-progress"
      start_extended_test '{{ smart_device.device }}' '{{ smart_device.type }}' '{{ smart_device.index }}' "$serial"
      all_smart_passed=false
      ;;
    rebooted)
      fail "host rebooted during the gate-owned extended SMART test for $serial"
      ;;
    failed)
      fail "extended SMART test did not complete cleanly for $serial"
      ;;
  esac
fi
{% endfor %}

$all_smart_passed || exit 0
restore_smartd || fail "cannot restore smartd after gate-owned extended tests"

case "$phase" in
  initial)
    touch "$state_dir/NEEDS_ZERO_ERROR_REVERIFICATION"
    log daemon.notice "initial scrub and fresh SMART tests passed; preserve evidence, clear counters deliberately, then run the zero-error re-verification scrub"
    ;;
  zero_error_reverification)
    assert_zero_vdev_errors "$report"
    touch "$state_dir/PASSED"
    log daemon.notice "zero-error scrub and fresh SMART tests passed; pve2 source integrity is migration-trusted"
    ;;
esac
