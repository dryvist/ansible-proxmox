{
  "domain": "example.com",
  "splunk_vm": {
    "splunk": {
      "ansible_connection": "ssh",
      "hostname": "splunk-aio",
      "ip": "192.168.0.200",
      "node": "pve-w1700",
      "vmid": 90200
    }
  },
  "containers": {
    "s3": {
      "ansible_connection": "community.proxmox.proxmox_pct_remote",
      "hostname": "s3",
      "ip": "192.168.0.20",
      "node": "pve-w1700",
      "pool_id": "infrastructure",
      "tags": [
        "container",
        "object-storage",
        "storage"
      ],
      "vmid": 902000,
      "mac": "02:00:00:00:00:01",
      "ansible_pct_vmid": 902000
    }
  },
  "node_storage": {
    "pve-w1700": {
      "smb": {
        "group_name": "nas",
        "workgroup": "WORKGROUP",
        "macos_optimized": true,
        "managed_users": [
          {
            "name": "jevans",
            "unix_groups": [
              "nas"
            ],
            "shell": "/usr/sbin/nologin",
            "create_home": false,
            "password_secret_env": "NAS_JEVANS_SMB_PASSWORD"
          }
        ]
      },
      "pools": {
        "bulk": {
          "datasets": {
            "jdrive": {
              "mountpoint": "/bulk/jdrive",
              "smb": {
                "share_name": "jdrive",
                "comment": "General file share"
              }
            },
            "timemachine": {
              "mountpoint": "/bulk/timemachine",
              "smb": {
                "share_name": "timemachine",
                "time_machine": true,
                "time_machine_max_size": "600G"
              }
            },
            "private": {
              "quota": "1T"
            }
          }
        }
      }
    }
  }
}
