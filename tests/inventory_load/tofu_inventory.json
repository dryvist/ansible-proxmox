{
  "domain": "example.com",
  "cache_proxy_urls": {
    "apt_cache": ["http://cache-a.example.com:3142", "http://cache-b.example.com:3142"]
  },
  "proxmox_user": "root",
  "proxmox_node": "pve-r710",
  "splunk_vm": {
    "splunk": {
      "ansible_connection": "ssh",
      "disks": [
        { "interface": "scsi0", "datastore": "local-zfs", "path": "vm-90200-disk-0" },
        { "interface": "virtio1", "datastore": "local-zfs", "path": "vm-90200-disk-1" }
      ],
      "hostname": "splunk-aio",
      "ip": "192.168.0.200",
      "node": "pve-w1700",
      "vmid": 90200
    }
  },
  "containers": {
    "fixture-rootpool-ct": {
      "ansible_connection": "community.proxmox.proxmox_pct_remote",
      "datastore": "local-zfs",
      "ha_replication_target": null,
      "hostname": "fixture-rootpool-ct",
      "node": "example-node-a",
      "pool_id": "test-only",
      "tags": ["container"],
      "vmid": 601100,
      "ansible_pct_vmid": 601100
    },
    "fixture-pvesr-ct": {
      "ansible_connection": "community.proxmox.proxmox_pct_remote",
      "datastore": "local-zfs",
      "ha_replication_target": "example-node-b",
      "hostname": "fixture-pvesr-ct",
      "node": "example-node-a",
      "pool_id": "test-only",
      "tags": ["container"],
      "vmid": 601200,
      "ansible_pct_vmid": 601200
    },
    "fixture-sandbox-ct": {
      "ansible_connection": "community.proxmox.proxmox_pct_remote",
      "datastore": "local-zfs",
      "hostname": "fixture-sandbox-ct",
      "node": "example-node-b",
      "pool_id": "test-only",
      "tags": ["container", "agent-sandbox"],
      "vmid": 601300,
      "ansible_pct_vmid": 601300
    },
    "postgres-ai-1": {
      "ansible_connection": "community.proxmox.proxmox_pct_remote",
      "hostname": "postgres-ai-1",
      "node": "pve-r710",
      "pool_id": "test-only",
      "tags": ["container", "database"],
      "vmid": 999998,
      "ansible_pct_vmid": 999998
    },
    "s3": {
      "ansible_connection": "community.proxmox.proxmox_pct_remote",
      "hostname": "s3",
      "ip": "192.168.0.20",
      "node": "pve-w1700",
      "pool_id": "infrastructure",
      "tags": ["container", "object-storage", "storage"],
      "vmid": 902000,
      "ansible_pct_vmid": 902000
    }
  },
  "nodes": {
    "example-node-a": {
      "cluster_roles": ["storage"]
    }
  },
  "vms": {
    "agent-sandbox": {
      "ansible_connection": "ssh",
      "disks": [
        { "interface": "scsi0", "datastore": "local-zfs", "path": "vm-515100-disk-0" },
        { "interface": "scsi1", "datastore": "local-zfs", "path": "vm-515100-disk-1" }
      ],
      "hostname": "agent-sandbox",
      "node": "example-node-b",
      "tags": ["agent-sandbox"],
      "vmid": 515100
    },
    "fixture-bulkdisk-vm": {
      "ansible_connection": "ssh",
      "disks": [
        { "interface": "scsi0", "datastore": "bulk-appdata", "path": "vm-601400-disk-0" }
      ],
      "hostname": "fixture-bulkdisk-vm",
      "node": "example-node-b",
      "tags": ["vm"],
      "vmid": 601400
    },
    "fixture-rootpool-vm": {
      "ansible_connection": "ssh",
      "disks": [
        { "interface": "scsi0", "datastore": "local-zfs", "path": "vm-601500-disk-0" },
        { "interface": "scsi1", "datastore": "local-zfs", "path": "vm-601500-disk-1" }
      ],
      "ha_replication_target": null,
      "hostname": "fixture-rootpool-vm",
      "node": "example-node-a",
      "tags": ["vm"],
      "vmid": 601500
    },
    "fixture-pvesr-vm": {
      "ansible_connection": "ssh",
      "disks": [
        { "interface": "scsi0", "datastore": "local-zfs", "path": "vm-601800-disk-0" }
      ],
      "ha_replication_target": "example-node-b",
      "hostname": "fixture-pvesr-vm",
      "node": "example-node-a",
      "tags": ["vm"],
      "vmid": 601800
    }
  },
  "node_storage": {
    "example-node-a": {
      "pools": {
        "bulk": {
          "datasets": {
            "appdata": {
              "pvesm_id": "bulk-appdata",
              "quota": "1T"
            }
          }
        }
      }
    },
    "pve-w1700": {
      "smb": {
        "group_name": "nas",
        "workgroup": "WORKGROUP",
        "macos_optimized": true,
        "managed_users": [
          {
            "name": "jevans",
            "unix_groups": ["nas"],
            "shell": "/usr/sbin/nologin",
            "create_home": false,
            "password_secret_env": "NAS_JEVANS_SMB_PASSWORD"
          }
        ]
      },
      "pools": {
        "bulk": {
          "datasets": {
            "jdrive": {
              "quota": "none",
              "mountpoint": "/bulk/jdrive",
              "smb": {
                "share_name": "jdrive",
                "comment": "General file share"
              }
            },
            "timemachine": {
              "quota": "600G",
              "mountpoint": "/bulk/timemachine",
              "smb": {
                "share_name": "timemachine",
                "time_machine": true,
                "time_machine_max_size": "600G"
              }
            },
            "private": {
              "quota": "1T"
            }
          }
        }
      }
    }
  }
}
